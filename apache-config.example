# HTTP -> HTTPS
<VirtualHost *:80>
    ServerName pptiny.example.com
    Redirect permanent / https://pptiny.example.com/
</VirtualHost>

<VirtualHost *:443>
    ServerName pptiny.example.com

    SSLEngine on
    SSLCertificateFile    /etc/letsencrypt/live/pptiny.example.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/pptiny.example.com/privkey.pem

    # HSTS, one year. Needs mod_headers.
    Header always set Strict-Transport-Security "max-age=31536000"

    # Host used in short_url responses.
    SetEnv PPTINY_HOST pptiny.example.com

    WSGIDaemonProcess pptiny
    WSGIScriptAlias / /var/www/pptiny/wsgi.py process-group=pptiny application-group=%{GLOBAL}

    <Directory /var/www/pptiny>
        <Limit GET HEAD>
            Require all granted
        </Limit>

        # Everything except GET/HEAD is localhost-only.
        <LimitExcept GET HEAD>
            Require ip 127.0.0.1 ::1
        </LimitExcept>
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/pptiny_error.log
    CustomLog ${APACHE_LOG_DIR}/pptiny_access.log combined
</VirtualHost>
